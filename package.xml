<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fast_calib</name>
  <version>0.0.0</version>

  <description>
    FAST-Calib: LiDAR-camera extrinsic calibration in one second (ROS 2 port).
  </description>

  <maintainer email="zhengcr@connect.hku.hk">Chunran Zheng</maintainer>

  <license>GPLv2</license>

  <author email="zhengcr@connect.hku.hk">Chunran Zheng</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rosbag2_cpp</depend>
  <depend>rosbag2_storage</depend>
  <depend>cv_bridge</depend>
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>

  <!-- Optional: only needed to read Livox CustomMsg lidar topics from a bag -->
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
